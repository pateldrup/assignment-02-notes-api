            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": [\n    { \"title\": \"Note one\",   \"content\": \"Content one\",   \"category\": \"work\"     },\n    { \"title\": \"Note two\",   \"content\": \"Content two\",   \"category\": \"study\"    },\n    { \"title\": \"Note three\", \"content\": \"Content three\", \"category\": \"personal\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/notes/bulk",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notes",
                "bulk"
              ]
            },
            "description": "Create multiple notes at once using insertMany."
          },
          "response": []
        },
        {
