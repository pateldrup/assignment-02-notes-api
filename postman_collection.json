    {
      "name": "CRUD Operations",
      "item": [
        {
          "name": "1. Create a Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team standup agenda\",\n  \"content\": \"Discuss sprint blockers and deployment plan\",\n  \"category\": \"work\",\n  \"isPinned\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/notes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "notes"
              ]
            },
            "description": "Create a single note in the database."
          },
          "response": []
        },
        {
